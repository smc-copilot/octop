# Copy into Octop global env (Dashboard → 高级设置 → 环境变量, or ~/.octop/env).
# BUSINESS_UI_* keys are visible to agent shells and MCP stdio. NEVER put
# passwords, PATs, user tokens, or service/client secrets in these values.
# Unique per Octop instance — do not reuse CONNECTION_ID + issuer + secrets across sites.
# Unset BUSINESS_UI_BASE_URL to disable env bootstrap.

# --- required once BASE_URL is set ---
BUSINESS_UI_BASE_URL=https://adapter.example.com
BUSINESS_UI_INSTANCE_ISSUER=https://octop.example.com
BUSINESS_UI_OPERATOR_USER_ID=1
BUSINESS_UI_SERVICE_SECRET_FILE=/etc/octop/business-ui/service.token

# --- optional with defaults (CONNECTION_ID=default, AUTH_METHOD=api_token,
# USER_AUTH_METHOD=oauth2, ENABLED=1, DISPLAY_NAME=CONNECTION_ID) ---
BUSINESS_UI_CONNECTION_ID=site-prod
BUSINESS_UI_DISPLAY_NAME=Production Adapter
BUSINESS_UI_AUTH_METHOD=api_token
BUSINESS_UI_USER_AUTH_METHOD=oauth2
BUSINESS_UI_ENABLED=1

# Loopback/private Adapter hosts need an explicit allowlist (never 169.254.0.0/16).
# BUSINESS_UI_PRIVATE_ALLOW=10.0.0.0/8
# BUSINESS_UI_EXTRA_ORIGINS=https://idp.example.com
# BUSINESS_UI_TLS_CA_FILE=/etc/octop/business-ui/adapter-ca.pem

# --- oauth2 (required when USER_AUTH_METHOD=oauth2; skip for native_login / PAT) ---
BUSINESS_UI_OAUTH_DISCOVERY_URL=https://idp.example.com/.well-known/openid-configuration
# Or without discovery, set both:
# BUSINESS_UI_OAUTH_AUTHORIZE_URL=https://idp.example.com/oauth/authorize
# BUSINESS_UI_OAUTH_TOKEN_URL=https://idp.example.com/oauth/token
# BUSINESS_UI_OAUTH_REVOKE_URL=https://idp.example.com/oauth/revoke
BUSINESS_UI_OAUTH_CLIENT_ID=replace-me
BUSINESS_UI_OAUTH_SCOPES=openid profile
# Optional confidential-client secret file (chmod 0600), never an inline value:
# BUSINESS_UI_OAUTH_CLIENT_SECRET_FILE=/etc/octop/business-ui/oauth-client.secret
